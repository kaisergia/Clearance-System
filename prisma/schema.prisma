// generator client
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Users  (all roles — admin / head_office / department / org / student)
// DATABASE SWAP POINT: This is the authoritative user table.
// Replace MOCK_USERS in login/page.tsx with queries against this model.
// ─────────────────────────────────────────────────────────────────────────────
model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  googleId    String?  @unique
  avatarUrl   String?  @db.Text
  role        Role
  displayName String
  createdAt   DateTime @default(now())

  // Role-specific entity links — at most one will be non-null per user
  officeId     Int?
  departmentId Int?
  orgId        Int?
  studentId    String?

  office     Office?     @relation(fields: [officeId],     references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  org        Org?        @relation(fields: [orgId],        references: [id])
  student    Student?    @relation(fields: [studentId],    references: [id])
}

enum Role {
  admin
  head_office
  department
  org
  student
}

// ─────────────────────────────────────────────────────────────────────────────
// Students
// ─────────────────────────────────────────────────────────────────────────────
model Student {
  id         String @id   // e.g. "2021-0492"
  name       String
  email      String @unique
  department String
  program    String
  year       String
  status     String @default("Pending")
  semester   String

  users            User[]
  clearanceRecords ClearanceRecord[]
  orgMemberships   OrgMember[]
  submissions      RequirementSubmission[]
  notifications    Notification[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Offices  (Head Offices — Registrar, Library, Guidance, etc.)
// ─────────────────────────────────────────────────────────────────────────────
model Office {
  id       Int    @id @default(autoincrement())
  name     String
  head     String
  email    String @unique
  pending  Int    @default(0)
  approved Int    @default(0)
  rejected Int    @default(0)
  logoUrl    String? @db.Text
  coverUrl   String? @db.Text
  themeColor String?

  users        User[]
  requirements OfficeRequirement[]
  announcements Announcement[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Departments  (CCIS, COE, CEDAS, …)
// ─────────────────────────────────────────────────────────────────────────────
model Department {
  id           Int    @id @default(autoincrement())
  name         String
  abbreviation String @unique
  head         String
  email        String @unique
  pending      Int    @default(0)
  approved     Int    @default(0)
  rejected     Int    @default(0)
  logoUrl      String? @db.Text
  coverUrl     String? @db.Text
  themeColor   String?

  users        User[]
  requirements DepartmentRequirement[]
  announcements Announcement[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Organisations  (Gov / LGU / AcademicClub / NonAcademicClub)
// ─────────────────────────────────────────────────────────────────────────────
model Org {
  id          Int     @id @default(autoincrement())
  name        String
  type        String  // Gov | LGU | AcademicClub | NonAcademicClub
  category    String
  department  String?
  program     String?
  adviser     String?
  status      String  @default("Active")
  dateAdded   String?
  memberCount Int     @default(0)
  logoUrl     String? @db.Text
  coverUrl    String? @db.Text
  themeColor  String?

  users        User[]
  members      OrgMember[]
  requirements OrgRequirement[]
  announcements Announcement[]
}

model OrgMember {
  id        Int    @id @default(autoincrement())
  orgId     Int
  studentId String

  org     Org     @relation(fields: [orgId],     references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([orgId, studentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Clearance Records  — one record per (student × entity)
// ─────────────────────────────────────────────────────────────────────────────
model ClearanceRecord {
  id           Int     @id @default(autoincrement())
  studentId    String
  officeId     Int?
  orgId        Int?
  departmentId Int?
  termId       Int?
  status       String  @default("Pending") // Cleared | Pending | Rejected | Submitted
  dateCleared  String?
  remarks      String? @db.Text
  uploadedFiles Json?   // { requirementId: fileUrl }
  completedTasks Json? // number[]

  student Student       @relation(fields: [studentId], references: [id])
  term    AcademicTerm? @relation(fields: [termId],    references: [id], onDelete: Cascade)

  // Each (student, entity, term) pair is unique
  @@unique([studentId, officeId, termId])
  @@unique([studentId, orgId, termId])
  @@unique([studentId, departmentId, termId])
  @@index([studentId])
  @@index([termId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Requirements  (per office / department / org)
// ─────────────────────────────────────────────────────────────────────────────
model OfficeRequirement {
  id                 String          @id @default(uuid())
  officeId           Int
  termId             Int?
  name               String
  description        String?         @db.Text
  linkName           String?
  linkUrl            String?
  addedDate          String
  status             String          @default("Draft") // Live | Draft
  appliesTo          Json            // string[]
  deadline           String?
  requiresUpload     Boolean         @default(false)
  type               RequirementType @default(MANUAL)
  autoApprove        Boolean         @default(false)
  surveyQuestions    Json?           // JSON array of survey questions
  acknowledgmentText String?         @db.Text

  office Office        @relation(fields: [officeId], references: [id])
  term   AcademicTerm? @relation(fields: [termId],    references: [id], onDelete: Cascade)

  @@index([officeId])
  @@index([termId])
}

model DepartmentRequirement {
  id                 String          @id @default(uuid())
  departmentId       Int
  termId             Int?
  name               String
  description        String?         @db.Text
  linkName           String?
  linkUrl            String?
  addedDate          String
  status             String          @default("Draft")
  appliesTo          Json
  deadline           String?
  requiresUpload     Boolean         @default(false)
  type               RequirementType @default(MANUAL)
  autoApprove        Boolean         @default(false)
  surveyQuestions    Json?
  acknowledgmentText String?         @db.Text

  department Department    @relation(fields: [departmentId], references: [id])
  term       AcademicTerm? @relation(fields: [termId],       references: [id], onDelete: Cascade)

  @@index([departmentId])
  @@index([termId])
}

model OrgRequirement {
  id                 String          @id @default(uuid())
  orgId              Int
  termId             Int?
  name               String
  description        String?         @db.Text
  linkName           String?
  linkUrl            String?
  addedDate          String
  status             String          @default("Draft")
  appliesTo          Json
  deadline           String?
  requiresUpload     Boolean         @default(false)
  type               RequirementType @default(MANUAL)
  autoApprove        Boolean         @default(false)
  surveyQuestions    Json?
  acknowledgmentText String?         @db.Text

  org  Org           @relation(fields: [orgId],  references: [id])
  term AcademicTerm? @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([termId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Submissions
// ─────────────────────────────────────────────────────────────────────────────
model RequirementSubmission {
  id               String           @id @default(uuid())
  requirementId    String
  studentId        String
  type             RequirementType
  uploadedFileUrls Json             // string[]
  paymentReference String?          // For PAYMENT_PROOF
  surveyAnswers    Json             // Array of { questionId: string, answer: string }
  acknowledged     Boolean          @default(false)
  submittedAt      DateTime         @default(now())
  status           SubmissionStatus @default(pending)
  reviewedBy       String?
  reviewNotes      String?          @db.Text

  student Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, requirementId])
  @@index([requirementId])
  @@index([studentId])
}

enum RequirementType {
  DOCUMENT_UPLOAD
  PAYMENT_PROOF
  SURVEY
  ACKNOWLEDGMENT
  MANUAL
}

enum SubmissionStatus {
  pending
  approved
  rejected
}

// ─────────────────────────────────────────────────────────────────────────────
// Announcements  (system-wide or scoped to office / department / org)
// ─────────────────────────────────────────────────────────────────────────────
model Announcement {
  id                Int       @id @default(autoincrement())
  title             String
  content           String    @db.Text
  priority          AnnouncementPriority @default(normal)
  isSystemWide      Boolean   @default(false)
  showOnLandingPage Boolean   @default(false)
  isActive          Boolean   @default(true)
  eventDate         String?   // ISO date string
  eventLocation     String?
  expiresAt         DateTime?
  imageUrls         Json?     // string[]
  linkLabel         String?
  linkUrl           String?
  appliesTo         Json?     // string[] - target audience filters
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Scoping — at most one will be set (null = system-wide)
  officeId          Int?
  departmentId      Int?
  orgId             Int?

  office            Office?     @relation(fields: [officeId],     references: [id])
  department        Department? @relation(fields: [departmentId], references: [id])
  org               Org?        @relation(fields: [orgId],        references: [id])

  @@index([isSystemWide, isActive])
  @@index([showOnLandingPage, isActive])
  @@index([officeId])
  @@index([departmentId])
  @@index([orgId])
}

enum AnnouncementPriority {
  low
  normal
  high
  urgent
}

// ─────────────────────────────────────────────────────────────────────────────
// Academic Terms, Clearance Flows, Flow Steps, & Prerequisites
// ─────────────────────────────────────────────────────────────────────────────

model AcademicTerm {
  id        Int             @id @default(autoincrement())
  name      String          @unique
  status    String          @default("Active") // "Active" | "Archived"
  flows     ClearanceFlow[]
  
  // Back-relations for term-specific requirements and clearance records
  officeRequirements     OfficeRequirement[]
  departmentRequirements DepartmentRequirement[]
  orgRequirements        OrgRequirement[]
  clearanceRecords       ClearanceRecord[]
  
  createdAt DateTime        @default(now())
}

model ClearanceFlow {
  id             Int          @id @default(autoincrement())
  name           String
  description    String?      @db.Text
  termId         Int
  term           AcademicTerm @relation(fields: [termId], references: [id])
  status         String       @default("Draft") // "Draft" | "Published" | "Archived"
  
  // JSON field describing targeting criteria (e.g. { year: ["4th Year"], department: [] })
  targetCriteria Json?
  
  steps          FlowStep[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model FlowStep {
  id             Int           @id @default(autoincrement())
  flowId         Int
  flow           ClearanceFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  
  // Represents who needs to clear this step.
  // officeId, departmentId, or orgId can be null if it's dynamic
  officeId       Int?
  departmentId   Int?
  orgId          Int?
  
  // If true, dynamically resolves to the student's department or active org memberships
  isDynamicDept  Boolean       @default(false)
  isDynamicOrgs  Boolean       @default(false)
  isPrerequisiteOnly Boolean     @default(false)
  
  sequenceOrder  Int           @default(1)
  
  // Self-relation to model dependencies/prerequisites
  prerequisites  FlowStepPrerequisite[] @relation("StepToPrerequisite")
  dependentSteps FlowStepPrerequisite[] @relation("PrerequisiteToStep")
}

model FlowStepPrerequisite {
  stepId             Int
  prerequisiteStepId Int
  
  step               FlowStep @relation("StepToPrerequisite", fields: [stepId], references: [id], onDelete: Cascade)
  prerequisiteStep   FlowStep @relation("PrerequisiteToStep", fields: [prerequisiteStepId], references: [id], onDelete: Cascade)
  
  @@id([stepId, prerequisiteStepId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications (In-App & Email Alert Log)
// ─────────────────────────────────────────────────────────────────────────────
model Notification {
  id          String    @id @default(uuid())
  studentId   String
  title       String
  message     String    @db.Text
  type        String    @default("evaluation") // "evaluation" | "deadline_warning" | "announcement" | "general"
  status      String    @default("unread")     // "unread" | "read"
  readAt      DateTime?
  linkUrl     String?
  createdAt   DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Institutional Audit Trail & Activity Logs
// ─────────────────────────────────────────────────────────────────────────────
model AuditLog {
  id                String   @id @default(uuid())
  actorId           String?  // User ID or account
  actorName         String   // e.g. "John Doe (Registrar Head)"
  actorRole         String   // "admin" | "head_office" | "department" | "org" | "student" | "system"
  action            String   // "CLEAR_STUDENT" | "UNCLEAR_STUDENT" | "FLAG_DEFICIENCY" | "BATCH_CLEAR" | "AUTO_APPROVE"
  targetStudentId   String?  // e.g. "2021-0492"
  targetStudentName String?  // e.g. "Jane Smith"
  entityType        String?  // "office" | "department" | "org" | "system"
  entityId          String?  // ID of office/department/org
  entityName        String?  // e.g. "Registrar's Office"
  details           String?  @db.Text // Description or remarks
  ipAddress         String?
  createdAt         DateTime @default(now())

  @@index([targetStudentId])
  @@index([actorId])
  @@index([createdAt])
}
